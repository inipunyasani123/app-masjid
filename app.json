{
  "expo": {
    "name": "Nurul Ufuk",
    "slug": "app-masjid",
    "version": "1.0.0",
    "scheme": "nurulufuk",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4EEE2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.pintuweb.demo.nurulufuk"
    },
    "android": {
      "package": "id.pintuweb.demo.nurulufuk",
      "adaptiveIcon": {
        "backgroundColor": "#141C33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Nurul Ufuk — Aplikasi Jemaah Masjid",
      "shortName": "Nurul Ufuk",
      "lang": "id",
      "themeColor": "#141C33",
      "backgroundColor": "#F4EEE2"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://app-masjid.pintuweb.id"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ElMessiri-SemiBold.ttf",
            "./assets/fonts/ElMessiri-Bold.ttf",
            "./assets/fonts/ReadexPro-Regular.ttf",
            "./assets/fonts/ReadexPro-Medium.ttf",
            "./assets/fonts/ReadexPro-SemiBold.ttf"
          ]
        }
      ]
    ]
  }
}
